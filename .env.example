# Copy to .env (repo root) or server/.env. Never commit the real file.

# ---------- App (Expo) ----------
# Where the app sends scans. On a physical iPhone use your computer's LAN IP, e.g. http://192.168.1.20:8787
EXPO_PUBLIC_API_URL=http://localhost:8787
# RevenueCat public iOS SDK key (appl_…). Empty = purchases disabled. Release builds read it from eas.json.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# ---------- Server ----------
PORT=8787

# Accounts
APPLE_BUNDLE_ID=company.tappy.app        # must match ios.bundleIdentifier in app.json
RESEND_API_KEY=                     # password reset emails via resend.com; empty hides "Forgot password?"
EMAIL_FROM=Tappy <no-reply@tappy.company>
SUPPORT_EMAIL=kartiknagani17@gmail.com
AUTH_RATE_LIMIT_PER_MINUTE=10       # login/signup/reset attempts per IP and per email
HOST=0.0.0.0                      # 127.0.0.1 behind Cloudflare Tunnel
TRUST_PROXY=false                 # true behind Cloudflare Tunnel (use CF-Connecting-IP for rate limits)
DATABASE_PATH=data/tappy.db
RAW_DATA_DIR=data/raw
UPLOADS_DIR=data/uploads

# Data sources (bulk files; no per-scan API calls)
USDA_API_KEY=                     # optional: only needed if you add FDC API calls; the CSV import doesn't use it
USDA_BRANDED_CSV_URL=https://fdc.nal.usda.gov/fdc-datasets/FoodData_Central_branded_food_csv_2026-10-29.zip
OFF_CSV_URL=https://static.openfoodfacts.org/data/en.openfoodfacts.org.products.csv.gz

# Live Open Food Facts fallback for barcodes missing locally (off by default)
OFF_LIVE_LOOKUP=false
OFF_USER_AGENT=Tappy/1.0 (you@example.com)   # OFF requires AppName/Version (ContactEmail)
OFF_LIVE_MAX_PER_MINUTE=12                  # OFF allows 15 product reads/min/IP

# Vision (front-of-package and ingredient-panel photos)
VISION_PROVIDER=openai             # openai | anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=                 # only for VISION_PROVIDER=anthropic
VISION_MODEL=gpt-6-luna            # anthropic: claude-haiku-5-5
VISION_ESCALATION_MODEL=gpt-6.1-sol  # anthropic: claude-sonnet-5-5
VISION_ESCALATE_BELOW_CONFIDENCE=0.6
VISION_MAX_IMAGE_BYTES=4000000

# Matching thresholds (front photo -> product)
MATCH_AUTO_CONFIRM_THRESHOLD=0.85   # >= : show top match for one-tap confirm
MATCH_CHOOSE_THRESHOLD=0.5          # >= : show top 3 to choose from; below: ask for barcode / ingredient photo
MATCH_AMBIGUITY_MARGIN=0.03         # top two within this -> show top 3 instead of one
MATCH_CANDIDATE_LIMIT=25

# Caching
SCAN_CACHE_TTL_SECONDS=604800
SCAN_CACHE_NEGATIVE_TTL_SECONDS=21600
VISION_CACHE_MAX_HAMMING=3          # max 3

# Limits
DAILY_FREE_SCANS=25
DAILY_FREE_PHOTO_SCANS=10
RATE_LIMIT_PER_MINUTE=30

# Subscriptions: subscribers (RevenueCat entitlement) get unlimited barcode scans.
REVENUECAT_SECRET_KEY=              # RevenueCat secret API key (v1, sk_...); empty = everyone gets the free limits
REVENUECAT_ENTITLEMENT_ID=tappy_pro
SUBSCRIBER_DAILY_PHOTO_SCANS=100    # fair-use cap on photo scans for subscribers

# Security / abuse controls
PHOTO_SCANNING=auto                 # auto | on (fail at startup without key) | off
VISION_DAILY_BUDGET_USD=20          # global daily vision spend ceiling; 0 = none
VISION_TIMEOUT_MS=30000
VISION_CONFIRM_CONSENSUS=3          # distinct networks before a photo->product choice is shared
IMAGE_MAX_INPUT_PIXELS=40000000
IP_DAILY_SCANS=300                  # per IP (IPv6 /64); 0 = off
IP_DAILY_PHOTO_SCANS=40
TRUST_PROXY=false                   # true / N hops only behind your own reverse proxy
CORS_ORIGINS=                       # comma-separated browser origins; empty for the native app
REQUEST_TIMEOUT_MS=60000
HEADERS_TIMEOUT_MS=15000
SHUTDOWN_TIMEOUT_MS=10000
