{
  "expo": {
    "name": "Tapi",
    "slug": "tapi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tapi.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Tapi uses your camera to scan product barcodes and check ingredients against your profile.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E3FC6D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Tapi uses your camera to scan product barcodes and check ingredients against your profile.",
          "recordAudioAndroid": false
        }
      ],
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E3FC6D",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220
        }
      ]
    ],
    "scheme": "tapi",
    "experiments": {
      "typedRoutes": false
    }
  }
}