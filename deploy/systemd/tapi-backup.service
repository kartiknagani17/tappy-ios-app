# Consistent snapshot of the live database (keeps the newest 2).
[Unit]
Description=Tapi database backup

[Service]
Type=oneshot
User=tapi
Group=tapi
WorkingDirectory=/opt/tapi/server
EnvironmentFile=/etc/tapi/tapi.env
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning src/cli.ts backup /var/lib/tapi/backups 2
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/tapi
