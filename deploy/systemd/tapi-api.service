# Tapi scan API. Listens on 127.0.0.1 only; Cloudflare Tunnel is the only way in.
[Unit]
Description=Tapi scan API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tapi
Group=tapi
WorkingDirectory=/opt/tapi/server
EnvironmentFile=/etc/tapi/tapi.env
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning src/http/server.ts
Restart=always
RestartSec=3
TimeoutStopSec=15

# Hardening: read-only system, writable data dir only.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/tapi

[Install]
WantedBy=multi-user.target
