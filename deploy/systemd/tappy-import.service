# Monthly full refresh: the whole Open Food Facts US export (catches anything the daily files
# missed) plus the newest USDA release if there is one. The daily refresh is tappy-update.
# Idempotent: unchanged records are skipped. Runs at low priority so scans stay fast.
#   Start by hand:   sudo systemctl start tappy-import
#   Watch progress:  journalctl -fu tappy-import
[Unit]
Description=Tappy product data download + import
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tappy
Group=tappy
WorkingDirectory=/opt/tappy/server
EnvironmentFile=/etc/tappy/tappy.env
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning src/cli.ts update-usda
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning src/cli.ts download off
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning src/cli.ts import-off
TimeoutStartSec=infinity
Nice=10
IOSchedulingClass=idle

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/tappy
