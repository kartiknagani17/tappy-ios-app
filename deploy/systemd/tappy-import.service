# Downloads the USDA + Open Food Facts bulk files and (re)imports them.
# Idempotent: unchanged records are skipped. Runs at low priority so scans stay fast.
#   Start by hand:   sudo systemctl start tappy-import
#   Watch progress:  journalctl -fu tappy-import
[Unit]
Description=Tappy product data download + import
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tappy
Group=tappy
WorkingDirectory=/opt/tappy/server
EnvironmentFile=/etc/tappy/tappy.env
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning src/cli.ts download
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning src/cli.ts import-usda
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning src/cli.ts import-off
TimeoutStartSec=infinity
Nice=10
IOSchedulingClass=idle

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/tappy
